      - [0, 0, 0, 1]
      - [0, 0, 0, 1]
      - [0, 0, 0, 1]
      - [0, 0, 0, 1]
    forward-speed-factor: 4

node-trees:
  []

instances:
  - model-file: Voxel.glb
    position: [0, 0, 0]
    rotation: [0, 0, 0]
    scale: 1
    swap-axes: false
    1st-anim-clip-number: 0
    2nd-anim-clip-number: 0
    anim-clip-speed: 1
    anim-blend-factor: 0
    enable-navigation: false
    path-target-instance: -1
  - model-file: Woman.gltf
    position: [-3.6351333, 0, 5.5970716]
    rotation: [0, 0, 0]
    scale: 1
    swap-axes: false
    1st-anim-clip-number: 0
    2nd-anim-clip-number: 0
    anim-clip-speed: 1
    anim-blend-factor: 0
    enable-navigation: false
